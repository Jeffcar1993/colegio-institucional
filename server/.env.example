# Example environment variables for the server and Telegram bot
# Use your Neon database connection string here.
# Example Neon URL:
# DATABASE_URL=postgresql://<user>:<password>@<branch>.db.neon.tech:5432/<dbname>?sslmode=require
DATABASE_URL=postgresql://user:password@localhost:5432/colegio
PORT=5000

# Telegram bot
TELEGRAM_BOT_TOKEN=
ADMIN_TELEGRAM_ID=

# Gemini (Google) API key for vision/OCR
GEMINI_API_KEY=

# Cloudinary (opcional) - para subir adjuntos públicamente
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Relay de radio (Plan B)
# Endpoint protegido por Caster.fm (upstream)
RADIO_SOURCE_URL=http://sapircast.caster.fm:19046/estVo
RADIO_SOURCE_USERNAME=source
RADIO_SOURCE_PASSWORD=replace-with-your-broadcast-password

# Cloudinary (opcional) - para subir adjuntos públicamente
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

